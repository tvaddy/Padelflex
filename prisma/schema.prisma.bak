datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id                    String                  @id @default(cuid())
  name                  String
  accessCode            String                  @default("default")
  eloRating             Float                   @default(1500.0) // Total-Elo (samlet rating)
  highestElo            Float                   @default(1500.0)
  lowestElo             Float                   @default(1500.0)
  isArchived            Boolean                 @default(false)
  createdAt             DateTime                @default(now())

  // Relasjoner
  leagueMemberships     LeagueMember[]
  tournamentEntries     TournamentParticipant[]

  teamAMatchesAsP1      Match[]                 @relation("TeamAPlayer1")
  teamAMatchesAsP2      Match[]                 @relation("TeamAPlayer2")
  teamBMatchesAsP1      Match[]                 @relation("TeamBPlayer1")
  teamBMatchesAsP2      Match[]                 @relation("TeamBPlayer2")
}

model League {
  id                 String         @id @default(cuid())
  name               String
  description        String?
  defaultTargetScore Int            @default(21)
  isArchived         Boolean        @default(false)
  accessCode         String         @default("default")
  completedAt        DateTime?
  createdAt          DateTime       @default(now())

  members     LeagueMember[]
  tournaments Tournament[]
}

model LeagueMember {
  id         String   @id @default(cuid())
  leagueId   String
  userId     String
  eloRating  Float    @default(1500.0)
  highestElo Float    @default(1500.0)
  lowestElo  Float    @default(1500.0)
  createdAt  DateTime @default(now())

  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
}

model Tournament {
  id                  String                  @id @default(cuid())
  name                String                  // f.eks "28.08.2026 #1" eller "Runde 4"
  isActive            Boolean                 @default(true)
  type                String                  @default("AMERICANO") // AMERICANO, MEXICANO
  courtCount          Int                     @default(1)
  targetScore         Int                     @default(21)
  originalTargetScore Int?
  isArchived          Boolean                 @default(false)
  accessCode          String                  @default("default")
  createdAt           DateTime                @default(now())
  completedAt         DateTime?

  leagueId            String?                 // null = Enkeltturnering, satt = tilhører en liga
  league              League?                 @relation(fields: [leagueId], references: [id], onDelete: SetNull)

  participants        TournamentParticipant[]
  matches             Match[]
}

model TournamentParticipant {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  
  totalPoints  Int        @default(0)
  matchesWon   Int        @default(0)
  matchesDrawn Int        @default(0)
  matchesLost  Int        @default(0)
  pausedCount  Int        @default(0)
  isPaused     Boolean    @default(false)
  
  // Turnering-spesifikk Elo & ratingutvikling
  tournamentElo Float     @default(1500.0)
  initialElo    Float     @default(1500.0)
  eloDelta      Float     @default(0.0)
  
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model Match {
  id             String      @id @default(cuid())
  tournamentId   String
  courtNumber    Int?        @default(1)
  status         MatchStatus @default(PENDING)
  version        Int         @default(1)
  date           DateTime    @default(now())
  startedAt      DateTime    @default(now())
  completedAt    DateTime?
  updatedAt      DateTime    @default(now()) @updatedAt

  teamAPlayer1Id String
  teamAPlayer2Id String
  teamBPlayer1Id String
  teamBPlayer2Id String

  teamAPlayer1   User        @relation("TeamAPlayer1", fields: [teamAPlayer1Id], references: [id])
  teamAPlayer2   User        @relation("TeamAPlayer2", fields: [teamAPlayer2Id], references: [id])
  teamBPlayer1   User        @relation("TeamBPlayer1", fields: [teamBPlayer1Id], references: [id])
  teamBPlayer2   User        @relation("TeamBPlayer2", fields: [teamBPlayer2Id], references: [id])

  teamAScore     Int         @default(0)
  teamBScore     Int         @default(0)
  winnerTeam     String?     // 'A', 'B' eller 'DRAW'
  isCompleted    Boolean     @default(false)

  // Elo rating tracking
  teamAEloBefore Float?
  teamBEloBefore Float?
  eloDelta       Float?

  tournament     Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, courtNumber, status])
  @@index([tournamentId, isCompleted])
  @@index([tournamentId, startedAt])
}

model StandaloneMatch {
  id             String    @id @default(cuid())
  name           String    @default("Padelkamp")
  accessCode     String    @default("default")
  
  teamAPlayer1   String
  teamAPlayer2   String
  teamBPlayer1   String
  teamBPlayer2   String

  teamAPlayer1Id String?
  teamAPlayer2Id String?
  teamBPlayer1Id String?
  teamBPlayer2Id String?

  format         String    @default("BEST_OF_3") // BEST_OF_1, BEST_OF_3, BEST_OF_3_SUPER_TB
  goldenPoint    Boolean   @default(true)
  
  // Scoring state serialized as JSON
  scoresJson     String    // Contains sets array, current point, history stack, serve
  winnerTeam     String?   // 'A' | 'B'
  isCompleted    Boolean   @default(false)
  
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([accessCode, isCompleted])
  @@index([createdAt])
}

